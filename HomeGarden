    local function getWildPetNames()
        local folder = Workspace:FindFirstChild("WildPets")
        if not folder then
            return {}
        end

        local pets = {}
        for _, obj in ipairs(folder:GetChildren()) do
            if obj:IsA("Model") then
                local name = obj.Name
                -- Wild_Rabbit -> Wild Rabbit
                name = tostring(name):gsub("^Wild[_ ]*", "")
                name = name:gsub("_", " ")
                if name == "" then name = obj.Name end
                table.insert(pets, name)
            end
        end

        table.sort(pets)
        return pets
    end

    local function updateWildPetLabel()
        local pets = getWildPetNames()

        if #pets == 0 then
            WildPetLabel.Text = "🐾 Wild Pet: None"
            WildPetLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
        elseif #pets == 1 then
            WildPetLabel.Text = "🐾 Wild Pet: " .. pets[1]
            WildPetLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
        else
            local shown = {}
            for i = 1, math.min(#pets, 3) do
                shown[#shown + 1] = pets[i]
            end
            local suffix = #pets > 3 and " +" .. (#pets - 3) or ""
            WildPetLabel.Text = "🐾 Wild Pets: " .. table.concat(shown, ", ") .. suffix
            WildPetLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
        end
    end

    local wildPetsFolder = Workspace:FindFirstChild("WildPets")
    if wildPetsFolder then
        wildPetsFolder.ChildAdded:Connect(function()
            task.defer(updateWildPetLabel)
        end)
        wildPetsFolder.ChildRemoved:Connect(function()
