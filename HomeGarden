-- ================================================

local seedData = {}
local selectedSeedKeys = { CARROT = true }
local autoBuySeedEnabled = false
local buyAmountPerCycle = 5
local SEED_RESTOCK_INTERVAL = 300 -- 5 menit
local seedNextRefreshAt = 0

local function loadSeedShop()
    if GetSeedShop then
        local success, data = pcall(function() return GetSeedShop:InvokeServer() end)
        if success and data and data.slots then
            seedData = {}
            for i, slot in pairs(data.slots) do
                seedData[slot.key] = {
                    name = slot.name, price = slot.price, stock = slot.stock, max = slot.max, key = slot.key, slotIndex = i
                }
            end

            -- Gunakan timestamp server jika response menyediakannya.
            local serverRefresh = data.nextRefresh or data.NextRefresh or data.RefreshEndsAt or data.nextRestock or data.NextRestock
            if type(serverRefresh) == "number" and serverRefresh > os.time() then
                seedNextRefreshAt = serverRefresh
            elseif seedNextRefreshAt <= os.time() then
                seedNextRefreshAt = os.time() + SEED_RESTOCK_INTERVAL
            end

            return data.slots
        end
    end
    return {}
end
loadSeedShop()

local function buySeed(seedKey, amount)
    amount = amount or 1
    if not seedKey or not seedData[seedKey] or seedData[seedKey].stock <= 0 then return false end
    local seed = seedData[seedKey]
    
    local success = false
    if BuySeedSlot then
        local s, r = pcall(function()
            for i = 1, amount do
                if seed.stock > 0 then BuySeedSlot:FireServer(seed.slotIndex); task.wait(0.1) end
            end
        end)
        if s then success = true end
    end
    
    if not success and BuySeed then
        local s, r = pcall(function() return BuySeed:InvokeServer(seedKey, amount) end)
        if s then success = true end
    end
    
    if success then task.spawn(function() task.wait(0.2); loadSeedShop() end); return true end
    return false
end

local autoBuySeedLoopRunning = false
local function autoBuySeedLoop()
    if autoBuySeedLoopRunning then return end
    autoBuySeedLoopRunning = true
    while autoBuySeedEnabled do
        local anyAvailable = false
        for key, isSelected in pairs(selectedSeedKeys) do
            if isSelected and autoBuySeedEnabled then
                loadSeedShop()
                local seed = seedData[key]
                if seed and seed.stock > 0 then
                    anyAvailable = true
                    buySeed(key, math.min(buyAmountPerCycle, seed.stock))
                    task.wait(0.2)
                end
            end
        end
        if not anyAvailable then
            task.wait(3)
        else
            task.wait(1.5)
        end
    end
    autoBuySeedLoopRunning = false
end

local function getSelectedSeedText()
    local names = {}
    for k, v in pairs(selectedSeedKeys) do
        if v then table.insert(names, seedData[k] and seedData[k].name or k) end
    end
    if #names == 0 then return "🌱 Seed: None" end
    if #names <= 1 then return "🌱 Seed: " .. table.concat(names, ", ") end
    return "🌱 Seed: " .. names[1] .. " (+" .. (#names-1) .. ")"
end

