-- ================================================
-- DROP ITEM: EQUIPPED HOTBAR ITEM
-- ================================================
-- Uses the same client-side flow as the game's DropItemClient:
-- HotbarSelectionChanged -> RequestDropEquipped(itemName, token)
-- The server decides whether the selected item is actually droppable.

local dropSelectedItem = ""
local dropRequestCounter = 0
local dropBusy = false

local function dropEligible(itemName)
    if type(itemName) ~= "string" or itemName == "" then
        return false
    end

    -- Match the game's DropItemClient eligibility rules.
    if itemName:sub(1, 7) == "FLIGHT:"
        or itemName:sub(1, 4) == "PET_"
        or itemName:sub(1, 7) == "POTTED_"
        or itemName:sub(1, 5) == "TOOL_" then
        return false
    end

    if itemName == "CRATE_NEWBIE" then
        return false
    end

    if itemName:sub(1, 5) == "GEAR_" then
        local gearName = itemName:sub(6)
        return gearName ~= "JETPACK"
            and gearName ~= "FLYING_BOARD"
            and gearName ~= "ULTRA_SPRAYER"
            and gearName ~= "MAX_SPRAYER"
    end

    -- Crops/seeds and normal world-drop item categories are supported.
    if itemName:sub(1, 5) == "CROP_"
        or itemName:sub(1, 4) == "EGG_"
        or itemName:sub(1, 6) == "CRATE_"
        or itemName:sub(1, 5) == "PROP_" then
        return true
    end

    local SeedConfig = RS:FindFirstChild("SeedConfig")
    if SeedConfig then
        local ok, config = pcall(require, SeedConfig)
        if ok and config and config.Seeds and config.Seeds[itemName] ~= nil then
            return true
        end
    end

    return false
end

local function setDropSelection(itemName)
    if type(itemName) ~= "string" then
        itemName = ""
    end
    dropSelectedItem = itemName
end

if HotbarSelectionChanged and HotbarSelectionChanged:IsA("BindableEvent") then
    HotbarSelectionChanged.Event:Connect(function(itemName)
        setDropSelection(itemName)
    end)
end

local function requestDropEquipped()
    if dropBusy then
        return false, "busy"
    end

    if not RequestDropEquipped then
        return false, "remote"
    end

    if not dropEligible(dropSelectedItem) then
        return false, "not_eligible"
    end

    dropBusy = true
    dropRequestCounter += 1

    local token = tostring(dropRequestCounter) .. ":" .. tostring(os.clock())
    local itemName = dropSelectedItem

    local ok = pcall(function()
        RequestDropEquipped:FireServer(itemName, token)
    end)

    if not ok then
        dropBusy = false
        return false, "failed"
    end

    return true, itemName
end

if DropRequestResult and DropRequestResult:IsA("RemoteEvent") then
    DropRequestResult.OnClientEvent:Connect(function(ok, result, _, message)
        dropBusy = false

        if ok and result == "DROPPED" then
            -- The real client clears its selected item after a successful drop.
            dropSelectedItem = ""
        elseif ok and result == "PICKED_UP" then
            -- Pickups do not originate from this button; keep the selection.
        end

        if message then
            print("[AzothAja Drop] " .. tostring(message))
        end
    end)
end

-- ================================================
-- MAILBOX: OPEN NATIVE GAME UI
-- ================================================
-- The game already has MailClient + MailboxPromptUI.
-- MailClient listens to ProximityPromptService.PromptTriggered
-- for a prompt named "MailboxPrompt" and then opens the real
-- MailGui/MailboxPanel. We therefore trigger that prompt instead
-- of creating a second fake mailbox UI.

local function getPromptWorldPosition(prompt)
    local parent = prompt and prompt.Parent
    if not parent then return nil end

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("BasePart") then
        return parent.Position
    elseif prompt:IsA("ProximityPrompt") and prompt.Adornee then
        local adornee = prompt.Adornee
        if adornee:IsA("Attachment") then
            return adornee.WorldPosition
        elseif adornee:IsA("BasePart") then
            return adornee.Position
        end
    end

    return nil
end

local function findMailboxPrompt()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local rootPos = root and root.Position

    local nearest = nil
    local nearestDistance = math.huge
    local fallback = nil

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "MailboxPrompt" then
            fallback = fallback or obj

            local pos = getPromptWorldPosition(obj)
            if pos and rootPos then
                local distance = (pos - rootPos).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = obj
                end
            end
        end
    end

    return nearest or fallback
end

local function openNativeMailbox()
    -- If the real MailGui is already open, don't create another UI.
    local playerGui = player:FindFirstChild("PlayerGui")
    local mailGui = playerGui and playerGui:FindFirstChild("MailGui")
    local mailboxPanel = mailGui and mailGui:FindFirstChild("MailboxPanel")
    local sendPanel = mailGui and mailGui:FindFirstChild("SendPanel")

    if mailboxPanel and mailboxPanel.Visible then
        return true
    end

    if sendPanel and sendPanel.Visible then
        return true
    end

    local prompt = findMailboxPrompt()
    if not prompt then
        warn("[AzothAja] MailboxPrompt tidak ditemukan.")
        return false
    end

    -- Preferred: executor's ProximityPrompt trigger.
    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)

        if ok then
            return true
        end
    end

    -- Fallback: fire the same client signal MailClient listens to.
    -- This mirrors the game's own PromptTriggered connection.
    if typeof(firesignal) == "function" then
        local ok = pcall(function()
            firesignal(ProximityPromptService.PromptTriggered, prompt, player)
        end)

        if ok then
            return true
        end
    end

    -- Last fallback: native Roblox prompt input simulation.
    local holdDuration = math.max(prompt.HoldDuration or 0, 0.05)
    local began = pcall(function()
        prompt:InputHoldBegin()
    end)

    if began then
        task.delay(holdDuration + 0.05, function()
            pcall(function()
                prompt:InputHoldEnd()
            end)
        end)
        return true
    end

    warn("[AzothAja] Gagal membuka MailboxPrompt.")
    return false
end

