-- ================================================
-- ADMIN ABUSE TICKETS / AUTO TELEPORT / INSTANT INTERACT
-- ================================================
-- The game currently exposes an ADMIN ABUSE folder with ticket
-- objects such as AATicket_33, AATicket_34, AATicket_35.
--
-- This section intentionally does NOT assume an unknown Admin Abuse
-- RemoteEvent. It discovers ProximityPrompts under the ticket objects.
-- If the game changes the ticket interaction into a server-only remote,
-- the script will report that the prompt was not found instead of
-- inventing a remote/argument format.

local adminAbuseEnabled = false
local adminAbuseTeleportEnabled = false
local instantInteractEnabled = false

local adminAbuseLoopRunning = false
local adminAbuseLastTicket = nil
local adminAbuseClaimed = {}

local instantInteractConnection = nil

local function getAdminAbuseFolder()
    return Workspace:FindFirstChild("ADMIN ABUSE")
        or Workspace:FindFirstChild("Admin Abuse")
        or Workspace:FindFirstChild("ADMIN_ABUSE")
end

local function isAdminAbuseTicket(obj)
    return obj and type(obj.Name) == "string"
        and obj.Name:match("^AATicket_%d+$") ~= nil
end

local function getWorldPosition(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    if obj:IsA("Attachment") then
        return obj.WorldPosition
    end

    if obj:IsA("Model") then
        local ok, pivot = pcall(function()
            return obj:GetPivot()
        end)
        if ok and pivot then
            return pivot.Position
        end

        local primary = obj.PrimaryPart
        if primary then
            return primary.Position
        end
    end

    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function findTicketPrompt(ticket)
    if not ticket then return nil end

    if ticket:IsA("ProximityPrompt") then
        return ticket
    end

    local direct = ticket:FindFirstChildWhichIsA("ProximityPrompt", true)
    if direct then return direct end

    -- Some builds put the prompt in a sibling/parent container.
    local parent = ticket.Parent
    if parent then
        for _, child in ipairs(parent:GetChildren()) do
            if child ~= ticket and child:IsA("ProximityPrompt") then
                return child
            end
        end
    end

    return nil
end

local function getAdminAbuseTickets()
    local folder = getAdminAbuseFolder()
    if not folder then return {} end

    local tickets = {}

    for _, obj in ipairs(folder:GetChildren()) do
        if isAdminAbuseTicket(obj) then
            table.insert(tickets, obj)
        end
    end

    table.sort(tickets, function(a, b)
        return tostring(a.Name) < tostring(b.Name)
    end)

    return tickets
end

local function getNearestAdminAbuseTicket()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local rootPos = root and root.Position

    local tickets = getAdminAbuseTickets()
    local nearest = nil
    local nearestDistance = math.huge

    for _, ticket in ipairs(tickets) do
        local pos = getWorldPosition(ticket)

        if pos and rootPos then
            local distance = (pos - rootPos).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = ticket
            end
        elseif not nearest then
            nearest = ticket
        end
    end

    return nearest
end

local function teleportToAdminAbuseTicket(ticket)
    if not ticket then return false end

    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local pos = getWorldPosition(ticket)

    if not root or not pos then
        return false
    end

    local target = CFrame.new(pos + Vector3.new(0, 3, 0))

    local ok = pcall(function()
        root.CFrame = target
    end)

    if ok then
        print("[AzothAja] Admin Abuse TP -> " .. tostring(ticket.Name))
    end

    return ok
end

local function triggerPromptInstant(prompt)
    if not prompt or not prompt.Parent then
        return false
    end

    -- Preferred executor helper.
    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)

        if ok then
            return true
        end
    end

    -- Client-side signal fallback.
    if typeof(firesignal) == "function" then
        local ok = pcall(function()
            firesignal(ProximityPromptService.PromptTriggered, prompt, player)
        end)

        if ok then
            return true
        end
    end

    -- Native fallback. HoldDuration is set to zero when possible.
    local began = pcall(function()
        prompt:InputHoldBegin()
    end)

    if began then
        task.defer(function()
            pcall(function()
                prompt:InputHoldEnd()
            end)
        end)
        return true
    end

    return false
end

local function claimAdminAbuseTicket(ticket)
    local prompt = findTicketPrompt(ticket)

    if not prompt then
        return false, "prompt_missing"
    end

    if instantInteractEnabled then
        pcall(function()
            prompt.HoldDuration = 0
        end)
    end

    local ok = triggerPromptInstant(prompt)

    if ok then
        print("[AzothAja] Admin Abuse claim -> " .. tostring(ticket.Name))
        return true, "claimed"
    end

    return false, "trigger_failed"
end

local function setPromptInstant(prompt, state)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return
    end

    if state then
        pcall(function()
            prompt.HoldDuration = 0
        end)
    end
end

local function setInstantInteract(state)
    instantInteractEnabled = state

    if instantInteractConnection then
        instantInteractConnection:Disconnect()
        instantInteractConnection = nil
    end

    if state then
        -- Apply to prompts already in Workspace.
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                setPromptInstant(obj, true)
            end
        end

        -- Apply to prompts created after the toggle.
        instantInteractConnection = Workspace.DescendantAdded:Connect(function(obj)
            if instantInteractEnabled and obj:IsA("ProximityPrompt") then
                task.defer(function()
                    if instantInteractEnabled and obj.Parent then
                        setPromptInstant(obj, true)
                    end
                end)
            end
        end)

        print("[AzothAja] Instant Interact: Enabled")
    else
        print("[AzothAja] Instant Interact: Disabled")
    end
end

local function clearMissingAdminAbuseClaims()
    local live = {}
    for _, ticket in ipairs(getAdminAbuseTickets()) do
        live[ticket] = true
    end

    for ticket in pairs(adminAbuseClaimed) do
        if not live[ticket] then
            adminAbuseClaimed[ticket] = nil
        end
    end
end

local function autoClaimAdminAbuseLoop()
    if adminAbuseLoopRunning then return end

    adminAbuseLoopRunning = true

    while adminAbuseEnabled do
        clearMissingAdminAbuseClaims()

        local tickets = getAdminAbuseTickets()

        if #tickets > 0 then
            for _, ticket in ipairs(tickets) do
                if not adminAbuseEnabled then break end

                if not adminAbuseClaimed[ticket] then
                    if adminAbuseTeleportEnabled then
                        teleportToAdminAbuseTicket(ticket)
                        task.wait(0.15)
                    end

                    local success, reason = claimAdminAbuseTicket(ticket)

                    if success then
                        adminAbuseClaimed[ticket] = true
                    elseif reason == "prompt_missing" then
                        -- Keep it unclaimed so it can be retried if the
                        -- prompt is inserted later.
                    end

                    task.wait(0.25)
                end
            end
        end

        task.wait(0.5)
    end

    adminAbuseLoopRunning = false
end

local function toggleAdminAbuse(state)
    adminAbuseEnabled = state

    if adminAbuseEnabled then
        task.spawn(autoClaimAdminAbuseLoop)
        print("[AzothAja] Admin Abuse Auto Claim: Enabled")
    else
        print("[AzothAja] Admin Abuse Auto Claim: Disabled")
    end
end

local function toggleAdminAbuseTeleport(state)
    adminAbuseTeleportEnabled = state
    print("[AzothAja] Admin Abuse Auto Teleport: " .. (state and "Enabled" or "Disabled"))

    -- If enabled while a ticket already exists, move once immediately.
    if state then
        local ticket = getNearestAdminAbuseTicket()
        if ticket then
            teleportToAdminAbuseTicket(ticket)
        end
    end
end


